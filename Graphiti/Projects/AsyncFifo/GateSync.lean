/-- What the stage reports is a prefix of what `syncReg` promises.  `syncOut_pack` is the
theorem that makes this go through: the bus-level stream *is* the three bits packed, so
the claim reduces to monotonicity of one bit, three times. -/
theorem out_q : pack3Out pk_b0 pk_b1 pk_b2 <+: syncOut lat su stl sp.1 sp.2.1 sp.2.2.1 := by
  rw [syncOut_pack]
  refine pack3Out_mono ?_ ?_ ?_
  · exact Hψ.w_pk_b0.trans (settleOut1_mono
      (Hψ.w_ff0_clk.trans (Hψ.e_clk ▸ List.prefix_rfl))
      (Hψ.w_ff0_d.trans (bitsOf_mono (wireOf_mono (Hψ.e_d ▸ List.prefix_rfl))))
      (Hψ.w_ff0_osel.trans (selBit_mono (Hψ.e_orc ▸ List.prefix_rfl)))
      (Hψ.w_ff0_ojunk.trans (junkBit_mono (Hψ.e_orc ▸ List.prefix_rfl))))
  · exact Hψ.w_pk_b1.trans (settleOut1_mono
      (Hψ.w_ff1_clk.trans (Hψ.e_clk ▸ List.prefix_rfl))
      (Hψ.w_ff1_d.trans (bitsOf_mono (wireOf_mono (Hψ.e_d ▸ List.prefix_rfl))))
      (Hψ.w_ff1_osel.trans (selBit_mono (Hψ.e_orc ▸ List.prefix_rfl)))
      (Hψ.w_ff1_ojunk.trans (junkBit_mono (Hψ.e_orc ▸ List.prefix_rfl))))
  · exact Hψ.w_pk_b2.trans (settleOut1_mono
      (Hψ.w_ff2_clk.trans (Hψ.e_clk ▸ List.prefix_rfl))
      (Hψ.w_ff2_d.trans (bitsOf_mono (wireOf_mono (Hψ.e_d ▸ List.prefix_rfl))))
      (Hψ.w_ff2_osel.trans (selBit_mono (Hψ.e_orc ▸ List.prefix_rfl)))
      (Hψ.w_ff2_ojunk.trans (junkBit_mono (Hψ.e_orc ▸ List.prefix_rfl))))

/-- What it has reported it has reported: the report is the packer's, and the packer's
inputs only grow. -/
theorem out_wf : Wf lat su stl pk_b0 pk_b1 pk_b2 clkF_in ff0_clk ff0_d ff0_osel ff0_ojunk ff1_clk ff1_d ff1_osel ff1_ojunk ff2_clk ff2_d ff2_osel ff2_ojunk unpB_d unpO_orc (sp.1, sp.2.1, sp.2.2.1, pack3Out pk_b0 pk_b1 pk_b2) := by
  exact { e_clk := Hψ.e_clk
          e_d := Hψ.e_d
          e_orc := Hψ.e_orc
          w_pk_b0 := Hψ.w_pk_b0
          w_pk_b1 := Hψ.w_pk_b1
          w_pk_b2 := Hψ.w_pk_b2
          w_ff0_clk := Hψ.w_ff0_clk
          w_ff0_d := Hψ.w_ff0_d
          w_ff0_osel := Hψ.w_ff0_osel
          w_ff0_ojunk := Hψ.w_ff0_ojunk
          w_ff1_clk := Hψ.w_ff1_clk
          w_ff1_d := Hψ.w_ff1_d
          w_ff1_osel := Hψ.w_ff1_osel
          w_ff1_ojunk := Hψ.w_ff1_ojunk
          w_ff2_clk := Hψ.w_ff2_clk
          w_ff2_d := Hψ.w_ff2_d
          w_ff2_osel := Hψ.w_ff2_osel
          w_ff2_ojunk := Hψ.w_ff2_ojunk
          h_q := List.prefix_rfl }

end Cases

/-! ### The refinement -/

theorem int_case_0 (lat su stl : Nat) (s : List Bool × List (BitVec 3) × List (Orc 2) × List (BitVec 3)) (i mid : stageT)
    (Hψ : ψ lat su stl i s)
    (Hrule : ((stageNetlist lat su stl).internals.getD 0 (fun _ _ => False)) i mid) :
    ∃ s', existSR (Timed.syncReg (n := 2) lat su stl).internals s s' ∧ ψ lat su stl mid s' := by
  obtain ⟨⟨pk_b0, pk_b1, pk_b2⟩, unpB_d, clkF_in, unpO_orc, ⟨ff0_clk, ff0_d, ff0_osel, ff0_ojunk⟩, ⟨ff1_clk, ff1_d, ff1_osel, ff1_ojunk⟩, ⟨ff2_clk, ff2_d, ff2_osel, ff2_ojunk⟩⟩ := i
  obtain ⟨⟨m_pk_b0, m_pk_b1, m_pk_b2⟩, m_unpB_d, m_clkF_in, m_unpO_orc, ⟨m_ff0_clk, m_ff0_d, m_ff0_osel, m_ff0_ojunk⟩, ⟨m_ff1_clk, m_ff1_d, m_ff1_osel, m_ff1_ojunk⟩, ⟨m_ff2_clk, m_ff2_d, m_ff2_osel, m_ff2_ojunk⟩⟩ := mid
  dsimp only [ψ] at Hψ ⊢
  have H := Hrule.1 rfl
  clear Hrule
  obtain ⟨⟨⟨c_pk_b0, c_pk_b1, c_pk_b2⟩, c_unpB_d, c_clkF_in, c_unpO_orc, ⟨c_ff0_clk, c_ff0_d, c_ff0_osel, c_ff0_ojunk⟩, ⟨c_ff1_clk, c_ff1_d, c_ff1_osel, c_ff1_ojunk⟩, ⟨c_ff2_clk, c_ff2_d, c_ff2_osel, c_ff2_ojunk⟩⟩, out, Hrule⟩ := H
  simp only [Prod.mk.injEq, and_assoc, and_true, true_and] at Hrule
  repeat' (obtain ⟨h, Hrule⟩ := Hrule; try subst h)
  exact ⟨s, existSR_reflexive, int_0 Hψ ‹_›⟩

