instance instMatch (lat su stl : Nat) : MatchInterface (stageNetlist lat su stl) (Timed.syncReg (n := 2) lat su stl) := by
  dsimp [stageNetlist, Timed.syncReg]
  solve_match_interface

/-! ### The invariant

Each node holds a prefix of what drives it, and the packer's bits are prefixes of what
their flip-flops settle to.  `h_q` is what the stage has already reported. -/

structure Wf (lat su stl : Nat) (pk_b0 pk_b1 pk_b2 clkF_in ff0_clk ff0_d ff0_osel ff0_ojunk ff1_clk ff1_d ff1_osel ff1_ojunk ff2_clk ff2_d ff2_osel ff2_ojunk : List Bool)
    (unpB_d : List (BitVec 3)) (unpO_orc : List (Orc 2))
    (s : List Bool × List (BitVec 3) × List (Orc 2) × List (BitVec 3)) : Prop where
  e_clk : clkF_in = s.1
  e_d : unpB_d = s.2.1
  e_orc : unpO_orc = s.2.2.1
  w_pk_b0 : pk_b0 <+: settleOut1 su stl ff0_clk ff0_d ff0_osel ff0_ojunk
  w_pk_b1 : pk_b1 <+: settleOut1 su stl ff1_clk ff1_d ff1_osel ff1_ojunk
  w_pk_b2 : pk_b2 <+: settleOut1 su stl ff2_clk ff2_d ff2_osel ff2_ojunk
  w_ff0_clk : ff0_clk <+: clkF_in
  w_ff0_d : ff0_d <+: bitsOf 0 (wireOf lat unpB_d)
  w_ff0_osel : ff0_osel <+: selBit 0 unpO_orc
  w_ff0_ojunk : ff0_ojunk <+: junkBit 0 unpO_orc
  w_ff1_clk : ff1_clk <+: clkF_in
  w_ff1_d : ff1_d <+: bitsOf 1 (wireOf lat unpB_d)
  w_ff1_osel : ff1_osel <+: selBit 1 unpO_orc
  w_ff1_ojunk : ff1_ojunk <+: junkBit 1 unpO_orc
  w_ff2_clk : ff2_clk <+: clkF_in
  w_ff2_d : ff2_d <+: bitsOf 2 (wireOf lat unpB_d)
  w_ff2_osel : ff2_osel <+: selBit 2 unpO_orc
  w_ff2_ojunk : ff2_ojunk <+: junkBit 2 unpO_orc
  h_q : s.2.2.2 <+: pack3Out pk_b0 pk_b1 pk_b2

def ψ (lat su stl : Nat) (i : stageT) (s : List Bool × List (BitVec 3) × List (Orc 2) × List (BitVec 3)) : Prop :=
  Wf lat su stl i.1.1 i.1.2.1 i.1.2.2 i.2.2.1 i.2.2.2.2.1.1 i.2.2.2.2.1.2.1 i.2.2.2.2.1.2.2.1 i.2.2.2.2.1.2.2.2 i.2.2.2.2.2.1.1 i.2.2.2.2.2.1.2.1 i.2.2.2.2.2.1.2.2.1 i.2.2.2.2.2.1.2.2.2 i.2.2.2.2.2.2.1 i.2.2.2.2.2.2.2.1 i.2.2.2.2.2.2.2.2.1 i.2.2.2.2.2.2.2.2.2 i.2.1 i.2.2.2.1 s

theorem Wf.init (lat su stl : Nat) : Wf lat su stl [] [] [] [] [] [] [] [] [] [] [] [] [] [] [] [] [] [] ([], [], [], []) :=
  ⟨rfl, rfl, rfl, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix, List.nil_prefix⟩

section SpecRules
variable (lat su stl : Nat) (sp : List Bool × List (BitVec 3) × List (Orc 2) × List (BitVec 3))

theorem spec_in_clk (v : List Bool) (h : sp.1 ⊏ v) :
    ((Timed.syncReg (n := 2) lat su stl).inputs.getIO ↑"clk").2 sp v (v, sp.2) := by
  rw [PortMap.rw_rule_execution (by dsimp [reducePortMapgetIO])]; exact ⟨h, rfl⟩

theorem spec_in_d (v : List (BitVec 3)) (h : sp.2.1 ⊏ v) :
    ((Timed.syncReg (n := 2) lat su stl).inputs.getIO ↑"d").2 sp v (sp.1, v, sp.2.2) := by
  rw [PortMap.rw_rule_execution (by dsimp [reducePortMapgetIO])]; exact ⟨h, rfl⟩

theorem spec_in_orc (v : List (Orc 2)) (h : sp.2.2.1 ⊏ v) :
    ((Timed.syncReg (n := 2) lat su stl).inputs.getIO ↑"orc").2 sp v (sp.1, sp.2.1, v, sp.2.2.2) := by
  rw [PortMap.rw_rule_execution (by dsimp [reducePortMapgetIO])]; exact ⟨h, rfl⟩

theorem spec_out_q (v : List (BitVec 3)) (h1 : sp.2.2.2 <+: v)
    (h2 : v <+: syncOut lat su stl sp.1 sp.2.1 sp.2.2.1) :
    ((Timed.syncReg (n := 2) lat su stl).outputs.getIO ↑"q").2 sp v (sp.1, sp.2.1, sp.2.2.1, v) := by
  rw [PortMap.rw_rule_execution (by dsimp [reducePortMapgetIO])]; exact ⟨h1, h2, rfl⟩
end SpecRules

