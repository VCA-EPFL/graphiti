theorem refines_initial : Module.refines_initial gateNext (nextBlock Bool (n := 2) 0 8) ψ := by
  intro i hi
  obtain ⟨⟨unp_st, unp_q1⟩, nfl_a, ⟨ok_a, ok_b⟩, fok_in, fp0_in, fp1_in, ⟨xp0_a, xp0_b⟩, ⟨cp0_a, cp0_b⟩, fc0_in, ⟨xp1_a, xp1_b⟩, ⟨cp1_a, cp1_b⟩, ⟨xp2_a, xp2_b⟩, fpa_in, fpb_in, fpc_in, ⟨xg0_a, xg0_b⟩, ⟨xg1_a, xg1_b⟩, fq2_in, ⟨xu1_a, xu1_b⟩, fu1_in, ⟨xu0_a, xu0_b⟩, ⟨xe2_a, xe2_b⟩, ⟨xe1_a, xe1_b⟩, ⟨xe0_a, xe0_b⟩, ⟨ae_a, ae_b⟩, ⟨af_a, af_b⟩, ⟨pk_p0, pk_p1, pk_p2, pk_fl, pk_q0, pk_q1, pk_q2, pk_g0, pk_g1, pk_g2, pk_we, pk_a0, pk_a1, pk_dt⟩⟩ := i
  dsimp only [gateNext] at hi
  simp only [Prod.mk.injEq, PackSt.mk.injEq, and_assoc] at hi
  obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ := hi
  refine ⟨_, rfl, ?_, rfl, rfl, rfl, rfl, List.nil_prefix⟩
  intro k; cases k <;> exact List.nil_prefix

/-- **The gates refine the next-state block.** -/
theorem gateNext_refines : gateNext ⊑ (nextBlock Bool (n := 2) 0 8) :=
  ⟨inferInstance, ψ, refines_ψ, refines_initial⟩

