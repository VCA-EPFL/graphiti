    try dsimp only [] at e1
    try dsimp only [] at e2
    try dsimp only [] at e3
    have ho := out_comb hw (dt := pk_dt) (e3 ▸ List.prefix_rfl)
    dsimp only [wires] at ho hd
    case_transition Hcontains : Module.outputs gateNext, ident,
