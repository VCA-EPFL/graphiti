theorem drv_mono {s} : Mono (drv s) := by
  intro a b _ k; cases k <;> exact List.prefix_rfl

/-- Growing the block's own inputs grows every value it computes.  `s` and `s'` are explicit:
they are only reachable through projections in the hypotheses, which unification cannot
invert, and left implicit the two collapse into one metavariable. -/
theorem drv_env (s : NextSt Bool 2) {st' : List (WSt 2)} {inc' : List Bool} {data' : List Bool} {q1' : List (BitVec 3)} (hst : s.st <+: st') (hinc : s.inc <+: inc') (hdata : s.data <+: data') (hq1 : s.q1 <+: q1') (w : Wires W) (k : W) :
    drv s w k <+: drv { s with st := st', inc := inc', data := data', q1 := q1' } w k := by
  cases k <;> simp only [drv]
  case nfl_a => exact W_unp_fl_mono hst hinc hdata hq1
  case ok_b => exact W_nfl_mono hst hinc hdata hq1
  case fok_in => exact W_ok_mono hst hinc hdata hq1
  case fp0_in => exact W_unp_p0_mono hst hinc hdata hq1
