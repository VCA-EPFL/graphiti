/-- The invariant: the wires are well formed, the inputs the netlist holds are the
specification's, and the packer has reported no more than the wires behind it hold. -/
def ψ (i : gateNextT) (s : NextSt Bool 2) : Prop :=
  Wf (drv s) (wires i)
    ∧ i.1.1 = s.st
    ∧ i.1.2 = s.q1
    ∧ i.2.2.1.1 = s.inc
    ∧ i.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.dt = s.data
    ∧ s.d <+: pack2Out ⟨(wires i .pk_p0), (wires i .pk_p1), (wires i .pk_p2), (wires i .pk_fl), (wires i .pk_q0), (wires i .pk_q1), (wires i .pk_q2), (wires i .pk_g0), (wires i .pk_g1), (wires i .pk_g2), (wires i .pk_we), (wires i .pk_a0), (wires i .pk_a1), (i.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.dt)⟩

/-- What the block reports meets the specification's combinational contract. -/
theorem out_comb {s : NextSt Bool 2} {w : Wires W} (hw : Wf (drv s) w) {dt : List Bool} (hdt : dt <+: s.data) :
    CombOut (nextDep Bool s) (nextFun Bool) (nextLen Bool s) 0 8 (pack2Out ⟨(w .pk_p0), (w .pk_p1), (w .pk_p2), (w .pk_fl), (w .pk_q0), (w .pk_q1), (w .pk_q2), (w .pk_g0), (w .pk_g1), (w .pk_g2), (w .pk_we), (w .pk_a0), (w .pk_a1), dt⟩) :=
  CombOut.of_prefix (pack2Out_mono' (hw .pk_p0) (hw .pk_p1) (hw .pk_p2) (hw .pk_fl) (hw .pk_q0) (hw .pk_q1) (hw .pk_q2) (hw .pk_g0) (hw .pk_g1) (hw .pk_g2) (hw .pk_we) (hw .pk_a0) (hw .pk_a1) hdt) (W_pack_comb s)

/-! ### One tactic for every connection -/

/-- Each of the packer's inputs either stands or advances; one `⊏` is in scope. -/
syntax "gn_pre" : tactic
/-- Every wire of `mid` is the wire of `i`: what an input rule changes is an input. -/
syntax "gn_same" : tactic
set_option hygiene false in
macro_rules
  | `(tactic| gn_pre) => `(tactic| first | exact List.prefix_rfl | exact (‹_ ⊏ _›).isPrefix)
  | `(tactic| gn_same) =>
      `(tactic| (intro j; cases j <;> dsimp only [wires] <;> exact List.prefix_rfl))

/-- `gn_case t` proves one connection: `t` is the monotonicity step that says the value now on
the wire is still a prefix of what the specification computes for it. -/
syntax "gn_case " term : tactic
set_option hygiene false in
